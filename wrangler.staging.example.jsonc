{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "build/index.js",
  "compatibility_date": "2026-11-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "api-chat-staging-db",
      "database_id": "REPLACE_WITH_STAGING_D1_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      },
      {
        "name": "USER_HUB",
        "class_name": "UserHub"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "UserHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "MESSAGE_RATE_LIMITER",
      "namespace_id": "421001",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "421002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "WS_RATE_LIMITER",
      "namespace_id": "421003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "ADMIN_KEY",
      "AUTH_KEY_V1",
      "AUTH_KEY_V2",
      "MESSAGE_KEY_V1",
      "MESSAGE_KEY_V2",
      "DEDUP_KEY"
    ]
  },
  "vars": {
    "ACTIVE_AUTH_KEY_VERSION": "1",
    "ACTIVE_MESSAGE_KEY_VERSION": "1",
    "PUBLIC_ORIGIN": "https://api-chat-staging.REPLACE_CLOUDFLARE_SUBDOMAIN.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "name": "api-chat-staging",
  "workers_dev": true
}
